# Copy this file to .env and fill in your keys
# .env is in .gitignore — it will never be committed

# Perplexity API key — get one at https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Apify API token — used as fallback when Perplexity is blocked (cloud IPs)
# Find yours at: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
